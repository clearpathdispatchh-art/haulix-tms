rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isCompanyMember(companyId) {
      return request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/companies/$(companyId)).data.memberUids;
    }
    
    function getUserRole(companyId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    
    match /companies/{companyId} {
      allow create: if request.auth != null;
      allow read: if isCompanyMember(companyId);
      allow update: if isCompanyMember(companyId) && 
        getUserRole(companyId) in ['owner', 'admin'];
      allow delete: if false;
      
      match /{document=**} {
        allow read: if isCompanyMember(companyId);
        allow create, update: if isCompanyMember(companyId);
        allow delete: if isCompanyMember(companyId) && 
          getUserRole(companyId) in ['owner', 'admin'];
      }
    }
    
    match /setup/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}