rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isCompanyMember(companyId) {
      return request.auth != null &&
        request.auth.uid in 
        firestore.get(/databases/(default)/documents/companies/$(companyId)).data.memberUids;
    }
    
    match /pod/{companyId}/{loadId}/{legId}/{fileName} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyMember(companyId) && 
        request.resource.size < 10 * 1024 * 1024;
    }
    
    match /uploads/{companyId}/{userId}/{fileName} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyMember(companyId) && 
        request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isCompanyMember(companyId) && 
        request.auth.uid == userId;
    }
    
    match /invoices/{companyId}/{fileName} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyMember(companyId) &&
        request.resource.size < 10 * 1024 * 1024;
    }
    
    match /signatures/{companyId}/{loadId}/{legId}/{fileName} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyMember(companyId) &&
        request.resource.size < 5 * 1024 * 1024;
    }
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}