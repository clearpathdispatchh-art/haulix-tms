rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Verify user belongs to a company
    function userBelongsToCompany(companyId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }
    
    // Helper: Get user's role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper: Check if user is admin/owner
    function isAdminOrOwner() {
      let role = getUserRole();
      return role == 'owner' || role == 'admin';
    }
    
    // ========== COMPANIES ==========
    match /companies/{companyId} {
      allow read: if isAuthenticated() && userBelongsToCompany(companyId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && userBelongsToCompany(companyId) && isAdminOrOwner();
      allow delete: if false; // Never delete companies from client
      
      // ========== LOADS (subcollection) ==========
      match /loads/{loadId} {
        allow read: if isAuthenticated() && userBelongsToCompany(companyId);
        allow create: if isAuthenticated() && userBelongsToCompany(companyId);
        allow update: if isAuthenticated() && userBelongsToCompany(companyId);
        allow delete: if isAuthenticated() && userBelongsToCompany(companyId) && isAdminOrOwner();
      }
      
      // ========== CUSTOMERS (subcollection) ==========
      match /customers/{customerId} {
        allow read: if isAuthenticated() && userBelongsToCompany(companyId);
        allow create, update: if isAuthenticated() && userBelongsToCompany(companyId);
        allow delete: if isAuthenticated() && userBelongsToCompany(companyId) && isAdminOrOwner();
      }
      
      // ========== LOCATIONS (subcollection) ==========
      match /locations/{locationId} {
        allow read: if isAuthenticated() && userBelongsToCompany(companyId);
        allow write: if isAuthenticated() && userBelongsToCompany(companyId) && isAdminOrOwner();
      }
      
      // ========== DRIVERS (subcollection) ==========
      match /drivers/{driverId} {
        allow read: if isAuthenticated() && userBelongsToCompany(companyId);
        allow create, update: if isAuthenticated() && userBelongsToCompany(companyId);
        allow delete: if isAuthenticated() && userBelongsToCompany(companyId) && isAdminOrOwner();
      }
      
      // ========== MESSAGES (subcollection) ==========
      match /messages/{messageId} {
        allow read: if isAuthenticated() && userBelongsToCompany(companyId);
        allow create: if isAuthenticated() && userBelongsToCompany(companyId);
        allow update: if isAuthenticated() && userBelongsToCompany(companyId);
      }
    }
    
    // ========== USERS (top-level) ==========
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if false;
    }
    
    // ========== RATE LIMITS (system use) ==========
    match /rateLimits_{companyId}/{userId} {
      allow read, write: if isAuthenticated();
    }
    
    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}